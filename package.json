{
  "name": "nx3-markdown-renderer",
  "version": "0.1.0",
  "description": "Framework-agnostic Web Component that renders Markdown (including thinking blocks, mermaid, inline SVG, canvas, alerts, TOC, DataTables toggle).",
  "type": "module",
  "main": "./dist/nx3-markdown-renderer.esm.js",
  "module": "./dist/nx3-markdown-renderer.esm.js",
  "types": "./dist/nx3-markdown-renderer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nx3-markdown-renderer.d.ts",
      "import": "./dist/nx3-markdown-renderer.esm.js"
    },
    "./core": {
      "types": "./dist/markdown-renderer-core.d.ts",
      "import": "./dist/markdown-renderer-core.js"
    },
    "./styles.css": "./dist/nx3-markdown-renderer.css"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/nx3-markdown-renderer.esm.js",
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "markdown",
    "web-component",
    "custom-element",
    "mermaid",
    "highlight.js",
    "renderer"
  ],
  "author": "serie-a-logistics-solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serie-a-logistics-solutions/nx3-markdown-renderer.git"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1"
  },
  "devDependencies": {
    "mermaid": "^11.16.0",
    "svg-pan-zoom": "^3.6.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
